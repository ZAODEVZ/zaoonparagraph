# zao onparagraph env. copy to .env and fill in. never commit the real .env.

# app.paragraph.com api token. used as a bearer token on every request.
PARAGRAPH_TOKEN=

# api base. defaults to https://app.paragraph.com if unset.
PARAGRAPH_API_BASE=https://app.paragraph.com

# comma separated collection ids for zao stats.
ZAO_COLLECTIONS=

# port for the box-card ui. defaults to 4317.
ZAO_UI_PORT=4317
